/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class BSTIterator {
    TreeNode root1 ;
    TreeNode root;
    int pointer;
    ArrayList<TreeNode> arr ;
    public void inorder(TreeNode root,ArrayList<TreeNode> arr){
        if(root==null) return ;
        inorder(root.left,arr);
        arr.add(root);
        inorder(root.right,arr);
    }
    public BSTIterator(TreeNode root) {
        this.root1=new TreeNode(-1);
        this.root=root;
        this.pointer=0;
        this.arr= new ArrayList<>();
        inorder(root,arr);
    }
    
    public int next() {
       return arr.get(pointer++).val;
    }
    
    public boolean hasNext() {
        return pointer < arr.size(); 
    }
}

